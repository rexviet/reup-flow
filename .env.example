# Copy to .env and fill in the required values below.
# Required (no default -- missing any of these crashes the nest service at
# bootstrap, see services/downloader/src/config/env.ts):
# API_KEY: at least 16 characters, letters/digits/underscore/hyphen only.
# Below 16 is rejected at bootstrap -- see env.ts's comment on why (also
# short enough that the redactor's exact-value registry would silently
# refuse to protect it even if it were accepted).
API_KEY=
DATABASE_URL=
REDIS_URL=
PARSER_BASE_URL=
# Known-public Douyin profile id, used only by the phase-7 F4 probe.
# Browser origins allowed to call the API cross-origin (comma-separated).
# services/web is always a different origin than this API; empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
PROBE_SEC_USER_ID=

# Optional -- defaults shown are applied by env.ts when unset.
# Port the orchestrator listens on. 0 means "let the OS pick a free port",
# which the bootstrap positive-control test relies on. Must be 0..65535 --
# an unvalidated PORT lets Number("abc") -> NaN bind a random ephemeral port,
# after which the compose healthcheck probes 3000, fails, and the container
# flaps as unhealthy with nothing in the logs explaining why.
PORT=3000
DATA_DIR=/data
DOWNLOAD_CONCURRENCY=6
ENUMERATE_SLEEP_MS_MIN=3000
ENUMERATE_SLEEP_MS_MAX=5000
LEASE_SECONDS=300
MAX_ATTEMPTS=3
URL_TTL_SECONDS=7200
DISK_RESERVE_BYTES=10737418240
EST_BYTES_PER_VIDEO=31457280

# Used by docker-compose.yml only (not validated by env.ts).
DOUYIN_COOKIE_FALLBACK=
POSTGRES_USER=reup
POSTGRES_PASSWORD=reup
POSTGRES_DB=reup

# ---------------------------------------------------------------------------
# Video localization infra (plan 261026-0147, phase 00). No real values here.
# Generate each secret with `openssl rand -hex 24` (hex only: some values are
# substituted into config files and URLs unescaped).
# ---------------------------------------------------------------------------
# Postgres roles created by db-init (infra/postgres/create-databases.sh).
TEMPORAL_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=
LOCALIZATION_DB_PASSWORD=

# Temporal.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# MinIO root. minio-init refuses to run while either is `minioadmin`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Downloader storage backend: `local` (DATA_DIR) or `s3`. With `s3`,
# S3_ENDPOINT, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are required, and
# S3_KEY_PREFIX must start with `source/` and end with `/` (the downloader's
# MinIO user can only write there). S3_STALE_UPLOAD_MS is the age after which an
# unfinished multipart upload is aborted (default 24h).
STORAGE_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=reup-media
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=source/
S3_STALE_UPLOAD_MS=86400000
# One MinIO user per service, scoped by prefix (infra/minio/init.sh).
S3_ACCESS_KEY_ID=downloader
S3_SECRET_ACCESS_KEY=
LOC_S3_ACCESS_KEY_ID=localization
LOC_S3_SECRET_ACCESS_KEY=
RENDER_S3_ACCESS_KEY_ID=renderer
RENDER_S3_SECRET_ACCESS_KEY=
LANGFUSE_S3_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_SECRET_ACCESS_KEY=

# ClickHouse (Langfuse's analytics store).
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=

# Langfuse v3. ENCRYPTION_KEY must be exactly 64 hex characters.
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
LANGFUSE_REDIS_PASSWORD=
# Sign-up is disabled, so the first org/project/user is seeded from these.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# The seeded project's API keys. Also what the workers send traces with.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# services/localization (plan 261026-0147, phase 03). Read by its workers and
# the starter; the compose allowlist per service is added with the workers.
# ---------------------------------------------------------------------------
# Postgres role `localization`, owner of the `localization` schema.
LOC_DATABASE_URL=

# LLM and vision OCR, OpenAI-compatible. https, or http only to an address in
# VOICESTUDIO_ALLOW_PRIVATE_HTTP_CIDRS.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LOCALIZER_MODEL=
DUBBER_MODEL=
# How the Localizer and the Dubber answer. `single` (default): everything they would
# look up is put in one prompt, so a step makes one model request, plus one more to
# rewrite only the lines that break their checks. `tools`: the tool-calling loop, one
# model request per tool call. A change applies to videos that reach the step after
# the agents worker restarts.
LOCALIZER_MODE=single
DUBBER_MODE=single
# In `single` mode: `off` (default) asks the model for the answer only (reasoning disabled
# in the request) and caps the answer at a size that grows with the number of lines, so a
# provider that reasons for thousands of tokens cannot; an answer cut off at the cap is
# retried. `default` sends the plain request. Tool-calling agents are not affected.
LOCALIZER_REASONING=off
DUBBER_REASONING=off
# How the Reviewer judges a render. `jev` (default): checks in code (timing, loudness,
# caption fit, source text left next to the caption, empty or foreign lines) plus one
# call to Jev, a typed decision model reached through OPENROUTER_BASE_URL with the same
# key, for whether each line says what its source says; only the text of the lines
# leaves the worker. `llm`: the vision agent, which needs REVIEWER_MODEL. A change applies
# to reviews that start after the agents worker restarts.
REVIEWER_MODE=jev
REVIEWER_JEV_MODEL=typesafe/jev-1.13
REVIEWER_MODEL=
JUDGE_MODEL=
OCR_MODEL=
# One of: xyxy_px, xyxy_norm1, xyxy_norm1000, yxyx_norm1000. The OCR provider refuses
# to start without it. A wrong value does not fail loudly: boxes land in the wrong
# place or outside the frame. deepseek/deepseek-v4.1-flash answers xyxy_norm1000
# (verified on real 1080x1920 frames); check any other model the same way.
OCR_BBOX_FORMAT=

# VoiceStudio (STT and TTS), OpenAI-compatible, on another machine. https, or
# plain http only to an IP literal inside the CIDR list (default: Tailscale).
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_ALLOW_PRIVATE_HTTP_CIDRS=100.64.0.0/10
STT_MODEL=
TTS_MODEL=
# The voice new workflows start with (read by the starter). Any id the provider
# lists works; the starter refuses to dispatch while VOICE_ID is not in
# GET /v1/audio/voices, because the server would silently substitute a preset.
VOICE_ID=
# Provider of that voice (voicestudio | openai_compat) and its settings, as a
# JSON object with that provider's closed settings model (no credentials).
VOICE_PROVIDER=voicestudio
VOICE_SETTINGS_JSON={}
# Language the workflow translates into.
TARGET_LANG=vi

# Workers and starter (phase 04). One concurrency limit per task queue; keep
# STT_CONCURRENCY + TTS_CONCURRENCY <= the number of GPU workers on VoiceStudio.
STT_CONCURRENCY=1
TTS_CONCURRENCY=2
MEDIA_CONCURRENCY=2
RENDER_CONCURRENCY=1
LLM_CONCURRENCY=8
# io carries subtitle detection: each activity holds a chunk of frames on disk and
# sends up to 8 vision requests at once.
IO_CONCURRENCY=2
# The starter starts nothing while this many workflows are running, and marks an
# outbox row `dead` after OUTBOX_MAX_ATTEMPTS failed dispatches.
MAX_OPEN_WORKFLOWS=10
OUTBOX_MAX_ATTEMPTS=5

# The dubbed track is normalised to this integrated loudness (LUFS) and true peak
# (dBTP). Read by the media worker.
LOUDNESS_LUFS=-14
TRUE_PEAK_DBTP=-1.5

# Captions (phase 07). The font file is read by BOTH the layout stage (worker-media,
# to measure lines) and the renderer (to draw them): one path, one file. In compose
# it is the mounted copy of assets/fonts. The cover is painted over the burned-in
# source subtitle; opacity is 0..1.
CAPTION_FONT_PATH=/assets/fonts/BeVietnamPro-SemiBold.ttf
COVER_COLOR=#101010
COVER_OPACITY=0.92

# Optional.
# S3_REGION, S3_BUCKET and S3_FORCE_PATH_STYLE above apply to localization too.
# DEMUCS_BIN=demucs
# PROVIDER_TIMEOUT_SECONDS=120
