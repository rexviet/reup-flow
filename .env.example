# Copy to .env and fill in the required values below.
# Required (no default -- missing any of these crashes the nest service at
# bootstrap, see services/downloader/src/config/env.ts):
# API_KEY: at least 16 characters, letters/digits/underscore/hyphen only.
# Below 16 is rejected at bootstrap -- see env.ts's comment on why (also
# short enough that the redactor's exact-value registry would silently
# refuse to protect it even if it were accepted).
API_KEY=
DATABASE_URL=
REDIS_URL=
PARSER_BASE_URL=
# Known-public Douyin profile id, used only by the phase-7 F4 probe.
# Browser origins allowed to call the API cross-origin (comma-separated).
# services/web is always a different origin than this API; empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
PROBE_SEC_USER_ID=

# Optional -- defaults shown are applied by env.ts when unset.
# Port the orchestrator listens on. 0 means "let the OS pick a free port",
# which the bootstrap positive-control test relies on. Must be 0..65535 --
# an unvalidated PORT lets Number("abc") -> NaN bind a random ephemeral port,
# after which the compose healthcheck probes 3000, fails, and the container
# flaps as unhealthy with nothing in the logs explaining why.
PORT=3000
DATA_DIR=/data
DOWNLOAD_CONCURRENCY=6
ENUMERATE_SLEEP_MS_MIN=3000
ENUMERATE_SLEEP_MS_MAX=5000
LEASE_SECONDS=300
MAX_ATTEMPTS=3
URL_TTL_SECONDS=7200
DISK_RESERVE_BYTES=10737418240
EST_BYTES_PER_VIDEO=31457280

# Used by docker-compose.yml only (not validated by env.ts).
DOUYIN_COOKIE_FALLBACK=
POSTGRES_USER=reup
POSTGRES_PASSWORD=reup
POSTGRES_DB=reup

# ---------------------------------------------------------------------------
# Video localization infra (plan 261026-0147, phase 00). No real values here.
# Generate each secret with `openssl rand -hex 24` (hex only: some values are
# substituted into config files and URLs unescaped).
# ---------------------------------------------------------------------------
# Postgres roles created by db-init (infra/postgres/create-databases.sh).
TEMPORAL_DB_PASSWORD=
LANGFUSE_DB_PASSWORD=
LOCALIZATION_DB_PASSWORD=

# Temporal.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# MinIO root. minio-init refuses to run while either is `minioadmin`.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# One MinIO user per service, scoped by prefix (infra/minio/init.sh).
S3_ACCESS_KEY_ID=downloader
S3_SECRET_ACCESS_KEY=
LOC_S3_ACCESS_KEY_ID=localization
LOC_S3_SECRET_ACCESS_KEY=
RENDER_S3_ACCESS_KEY_ID=renderer
RENDER_S3_SECRET_ACCESS_KEY=
LANGFUSE_S3_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_SECRET_ACCESS_KEY=

# ClickHouse (Langfuse's analytics store).
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=

# Langfuse v3. ENCRYPTION_KEY must be exactly 64 hex characters.
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
LANGFUSE_REDIS_PASSWORD=
# Sign-up is disabled, so the first org/project/user is seeded from these.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# The seeded project's API keys. Also what the workers send traces with.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
