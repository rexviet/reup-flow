<clickhouse>
  <!-- Langfuse is a trace store for 1-3 operators; the defaults assume a
       dedicated host. Stay well inside the container's mem_limit. -->
  <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>
  <!-- system log tables are the largest idle consumers and are not read. -->
  <trace_log remove="1"/>
  <text_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <query_thread_log remove="1"/>
  <opentelemetry_span_log remove="1"/>
</clickhouse>
