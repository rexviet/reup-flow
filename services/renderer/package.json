{
  "name": "@reup-flow/renderer",
  "version": "0.0.0",
  "private": true,
  "description": "Renders an EditSpec into one mp4 per spec hash: a Temporal worker on the `render` queue driving Remotion.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "render:local": "tsc -p tsconfig.json && node dist/cli.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/resources": "1.30.1",
    "@opentelemetry/sdk-node": "0.57.2",
    "@remotion/bundler": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@temporalio/activity": "1.24.0",
    "@temporalio/interceptors-opentelemetry": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "ajv": "8.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@opentelemetry/sdk-trace-node": "1.30.1",
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
