{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": { "node": true, "es2022": true, "jest": true },
  "ignorePatterns": ["dist/", "node_modules/", "src/Douyin_TikTok_Download_API/"],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      // ESLint replaces (does not merge) rule options between overrides. This temporalio
      // pattern is copied into the jobs/videos/cookie override below on purpose: do not de-duplicate it.
      "files": ["services/downloader/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@temporalio/*"],
                "message": "Only src/workspace and src/temporal read Temporal. The downloader never starts or signals a workflow: it writes localization_outbox in markDone's transaction and stops. The workflow engine is the localization service's concern."
              }
            ]
          }
        ]
      }
    },
    {
      // The one place the downloader may import the Temporal client: the read-only
      // workspace view. It still may not reach a lane, and nothing outside these two
      // directories may import Temporal (the generic rule above stays for them).
      "files": ["services/downloader/src/workspace/**", "services/downloader/src/temporal/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/lanes/**", "**/lanes"],
                "message": "The workspace view never calls a lane: it reads Temporal and Postgres and writes nothing."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "services/downloader/src/jobs/**",
        "services/downloader/src/videos/**",
        "services/downloader/src/cookie/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@temporalio/*"],
                "message": "Only src/workspace and src/temporal read Temporal. The downloader never starts or signals a workflow: it writes localization_outbox in markDone's transaction and stops. The workflow engine is the localization service's concern."
              },
              {
                "group": ["**/lanes/**", "**/lanes"],
                "message": "The HTTP layer never calls a lane (plan.md §0 principle 1): Postgres is the only channel between the two. A controller/service under jobs/, videos/, or cookie/ must write a row and stop -- the lane picks it up on its own poll."
              }
            ]
          }
        ]
      }
    }
  ]
}
