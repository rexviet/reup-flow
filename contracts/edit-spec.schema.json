{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "description": "Pixel box, `[x, y, w, h]` in the source frame.",
      "properties": {
        "h": {
          "exclusiveMinimum": 0,
          "title": "H",
          "type": "integer"
        },
        "w": {
          "exclusiveMinimum": 0,
          "title": "W",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Caption": {
      "additionalProperties": false,
      "properties": {
        "caption_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption Color"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "font_px": {
          "exclusiveMinimum": 0,
          "title": "Font Px",
          "type": "integer"
        },
        "segment_id": {
          "minimum": 0,
          "title": "Segment Id",
          "type": "integer"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "text",
        "font_px"
      ],
      "title": "Caption",
      "type": "object"
    },
    "Cover": {
      "additionalProperties": false,
      "description": "Region painted over the burned-in source subtitle. The colour and opacity are\npart of the spec (and so of its hash): a render made with another colour is not\nthe same render. `opacity_pct` is an integer so the spec holds no float, which\ntwo languages would write differently.",
      "properties": {
        "color": {
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "only_with_captions": {
          "default": false,
          "title": "Only With Captions",
          "type": "boolean"
        },
        "opacity_pct": {
          "maximum": 100,
          "minimum": 0,
          "title": "Opacity Pct",
          "type": "integer"
        },
        "region": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "region",
        "color",
        "opacity_pct"
      ],
      "title": "Cover",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audio_key": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Audio Key",
      "type": "string"
    },
    "audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "caption_box": {
      "$ref": "#/$defs/BBox"
    },
    "captions": {
      "items": {
        "$ref": "#/$defs/Caption"
      },
      "maxItems": 2000,
      "title": "Captions",
      "type": "array"
    },
    "cover": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cover"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "exclusiveMinimum": 0,
      "maximum": 900000,
      "title": "Duration Ms",
      "type": "integer"
    },
    "font": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Font",
      "type": "string"
    },
    "font_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Font Sha256",
      "type": "string"
    },
    "fps": {
      "exclusiveMinimum": 0,
      "maximum": 120,
      "title": "Fps",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Height",
      "type": "integer"
    },
    "script_version": {
      "minimum": 0,
      "title": "Script Version",
      "type": "integer"
    },
    "source_key": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Source Key",
      "type": "string"
    },
    "width": {
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "source_key",
    "audio_key",
    "audio_sha256",
    "script_version",
    "width",
    "height",
    "fps",
    "duration_ms",
    "cover",
    "caption_box",
    "captions",
    "font",
    "font_sha256"
  ],
  "title": "EditSpec",
  "type": "object"
}
